OT_regular = hourly_rate * 1.5
OT_excess = hourly_rate * 2
hourly_limit = 35
Hourly_regular = 25

#Read the hour input
hours = float(input("Enter working hours: "))

if hours <= 35:
    regular_pay = hours * hourly_rate
else:
    regular_pay = hourly_limit * hourly_rate
    hours -= hourly_limit

if hours <= 25:
    OT_pay = hours * OT_regular
else:
    OT_pay = 25 * OT_regular
    hours -= 25
    OT_pay += hours * OT_excess

print("\n{:15s}: RM{:.2f}".format("Total salary", regular_pay + OT_pay))
