# get input
saving = int(input("Enter the monthly saving amount: "))

# calculations
interestRate = 0.05 / 12
month1 = saving * (1 + interestRate)
month2 = (saving + month1) * (1 + interestRate)
month3 = (saving + month2) * (1 + interestRate)
month4 = (saving + month3) * (1 + interestRate)
month5 = (saving + month4) * (1 + interestRate)
month6 = (saving + month5) * (1 + interestRate)

print("After the sixth month, the account value is ", round(month6,2))

