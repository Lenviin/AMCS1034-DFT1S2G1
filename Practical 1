# Program to find student with highest GPA
class Student:
    def __init__(self, name, hours, points):
        self.name = name
        self.hours = float(hours)
        self.points = float(points)

    def get_name(self):
        return self.name

    def get_hours(self):
        return self.hours

    def get_points(self):
        return self.points

    def gpa(self):
        return self.points / self. hours

def make_student(info_str):
    # info_str is a tab-seperated line: name hours points
    name, hours, points = info_str.split("\t")

    # Returns a corresponding Student object
    return Student(name, hours, points)

def main():
    # Open the input file for reading
    file_name = input("Enter the name of the grade file: ")
    in_file = open(file_name, 'r')

    # Set the first student in the file as the best student
    best_student = make_student(in_file.readline())

    # Process subsequent lines of the file
    for line in in_file:
        # Turn a line into a student record
        tempo = make_student(line)

        # If this student is the best student so far, remember it
        if tempo.gap() > best_student.gpa():
            best_student = tempo

    in_file.close()

    # Print information about the best student
    print()
    print("Best student: {}".format(best_student.get_name()))
    print("Hours       : {:.0f}".format(best_student.get_hours()))
    print("GPA         : {:.2f}".format(best_student.gpa()))

main()

